<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_wb_wholesale_config_form" model="ir.ui.view">
            <field name="name">wb.wholesale.config.form</field>
            <field name="model">wb.wholesale.config</field>
            <field name="arch" type="xml">
                <form string="Configuración de responsables">
                    <sheet>
                        <div class="oe_title">
                            <h1>Ventas al Mayoreo</h1>
                            <h3 class="text-muted">Responsables de las actividades</h3>
                        </div>

                        <group>
                            <field name="company_id"
                                   options="{'no_create': True, 'no_open': True}"
                                   groups="base.group_multi_company"/>
                        </group>

                        <group string="Responsables">
                            <field name="data_wholesale_finance_user_id"
                                   options="{'no_create': True}"/>
                            <field name="data_wholesale_carrier_user_id"
                                   options="{'no_create': True}"/>
                            <field name="data_wholesale_internal_user_id"
                                   options="{'no_create': True}"/>
                            <field name="data_wholesale_picking_user_id"
                                   options="{'no_create': True}"/>
                        </group>

                        <div class="alert alert-info" role="alert">
                            Cada responsable se suma como seguidor de la orden únicamente
                            cuando se le asigna su actividad, de modo que la lista de
                            seguidores se limita a los involucrados reales.
                            <br/>
                            Si un responsable se deja vacío, su actividad se asigna al
                            vendedor de la orden y queda registro en el log del servidor.
                            <br/>
                            La actividad de guía se enruta según el carrier de la orden:
                            los carriers marcados como <b>Logística interna o Pick Up</b>
                            van al responsable de logística interna; el resto, al de
                            paquetería.
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- La acción resuelve el registro de la compañía activa y abre su formulario -->
        <record id="action_wb_wholesale_config" model="ir.actions.server">
            <field name="name">Configuración de responsables</field>
            <field name="model_id" ref="model_wb_wholesale_config"/>
            <field name="state">code</field>
            <field name="code">action = model.action_open_config()</field>
        </record>

        <!-- Ventas > Configuración exige ser manager de ventas. Se añade el manager
             de mayoreo a los grupos del menú para que pueda llegar a su sección,
             sin otorgarle el rol completo de administrador de ventas. -->
        <record id="sale.menu_sale_config" model="ir.ui.menu">
            <field name="groups_id" eval="[(4, ref('wb_sale_wholesale_approval.group_wholesale_manager'))]"/>
        </record>

        <menuitem id="menu_wb_wholesale_config_root"
                  name="Venta mayoreo"
                  parent="sale.menu_sale_config"
                  groups="wb_sale_wholesale_approval.group_wholesale_manager"
                  sequence="90"/>

        <menuitem id="menu_wb_wholesale_config_responsibles"
                  name="Configuración de responsables"
                  parent="menu_wb_wholesale_config_root"
                  action="action_wb_wholesale_config"
                  groups="wb_sale_wholesale_approval.group_wholesale_manager"
                  sequence="10"/>

    </data>
</odoo>
