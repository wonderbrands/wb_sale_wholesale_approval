<odoo>
    <data>
        <record id="group_sales_wholesale_user" model="res.groups">
            <field name="name">Ventas / Usuario de Ventas al Mayoreo</field>
        </record>

        <record id="group_finance_user" model="res.groups">
            <field name="name">Ventas / Usuario de Aprobación de Finanzas</field>
            <field name="implied_ids" eval="[(4, ref('group_sales_wholesale_user'))]"/>
        </record>

        <record id="group_sales_commercial_user" model="res.groups">
            <field name="name">Ventas / Comercial</field>
        </record>

        <!-- Manager de mayoreo: además de operar como usuario de mayoreo, puede
             configurar los responsables de las actividades sin depender de un
             administrador del sistema. -->
        <record id="group_wholesale_manager" model="res.groups">
            <field name="name">Ventas / Manager de Ventas al Mayoreo</field>
            <field name="implied_ids" eval="[(4, ref('group_sales_wholesale_user'))]"/>
        </record>
    </data>
</odoo>